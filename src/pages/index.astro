---
import { cafe } from '../data/cafe';
import CallMenu from '../components/CallMenu.astro';
import '../styles/global.css';

const isVerified = (value: string) => value.length > 0 && !value.startsWith('[');
const phoneFooterDigits = cafe.phoneFooter.replace(/\D/g, '');
const phoneFooterHref = isVerified(cafe.phoneFooter) && phoneFooterDigits ? `tel:${phoneFooterDigits}` : undefined;
const mapHref = isVerified(cafe.map) && cafe.map.startsWith('http') ? cafe.map : undefined;
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{cafe.name}</title>
    <meta name="description" content={`${cafe.name} · ligue ${cafe.phone}`} />
    <meta name="theme-color" content="#5a0a1b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_PT" />
    <meta property="og:title" content="Café o Alexandre" />
    <meta property="og:description" content="Café o Alexandre · Av. Principal 51, 2665-305 Milharado · 07:00–20:00" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Saltar para o conteúdo</a>

    <header class="site-header">
      <nav class="site-nav shell" aria-label="Navegação principal">
        <a class="wordmark" href="#main-content" aria-label={`${cafe.name} início`}>
          <img class="wordmark__image" src="/images/cafe-o-alexandre.jpg" alt="" width="64" height="36" aria-hidden="true" />
          <span>{cafe.name}</span>
        </a>
        <div class="site-nav__links">
          <a href="#visit">Visitar</a>
          <a href="#gallery">Fotografias</a>
          <CallMenu variant="nav" />
        </div>
      </nav>
    </header>

    <main id="main-content">
      <section class="hero" aria-labelledby="page-title">
        <div class="shell hero__grid">
          <div class="hero__copy">
            <p class="hero__kicker">Café local em Milharado</p>
            <h1 id="page-title"><span>Café o</span> <em>Alexandre</em></h1>
            <p class="hero__welcome">{cafe.welcome}</p>
            <div class="hero__actions" aria-label="Contactos e direções">
              <CallMenu variant="action" />
              {mapHref ? (
                <a class="action action--secondary" href={mapHref} target="_blank" rel="noreferrer" style="--i: 1">Obter direções</a>
              ) : (
                <span class="action action--unavailable" role="status" style="--i: 1">Direções em breve</span>
              )}
            </div>
            <p class="hero__address">
              <span class="label">Visite-nos</span>
              <span>{cafe.address}</span>
            </p>
          </div>

          <div class="hero-art-wrap" aria-hidden="true">
            <div class="hero-art__steam" aria-hidden="true"><span></span><span></span><span></span></div>
            <figure class="hero-art">
              <img class="hero-art__image" src="/images/cafe-o-alexandre.jpg" alt="Imagem promocional do Café o Alexandre com uma chávena de café" width="1600" height="893" fetchpriority="high" decoding="async" />
            </figure>
            <div class="hero-art__badge" aria-hidden="true">
              <small>Horário</small>
              <strong>{cafe.hours}</strong>
            </div>
          </div>
        </div>
        <div class="hero__cue" aria-hidden="true">
          <span class="hero__cue-track"><span class="hero__cue-dot"></span></span>
        </div>
      </section>

      <div class="welcome-strip" aria-labelledby="how-title">
        <div class="shell welcome-strip__inner">
          <header class="welcome-strip__head" data-reveal>
            <p class="section-heading__index">Como visitar</p>
            <h3 id="how-title" class="welcome-strip__title">Em três passos simples</h3>
          </header>
          <ol class="welcome-steps">
            <li data-reveal style="--i: 0">
              <CallMenu variant="step" />
            </li>
            <li data-reveal style="--i: 1">
              {mapHref ? (
                <a class="welcome-step" href={mapHref} target="_blank" rel="noreferrer">
                  <span class="welcome-step__num" aria-hidden="true">02</span>
                  <span class="welcome-step__label">Visite-nos</span>
                  <span class="welcome-step__fact">Av. Principal 51, Milharado</span>
                  <span class="welcome-step__note">Em Milharado.</span>
                </a>
              ) : (
                <span class="welcome-step">
                  <span class="welcome-step__num" aria-hidden="true">02</span>
                  <span class="welcome-step__label">Visite-nos</span>
                  <span class="welcome-step__fact">Morada em breve</span>
                  <span class="welcome-step__note">Em Milharado.</span>
                </span>
              )}
            </li>
            <li data-reveal style="--i: 2">
              <a class="welcome-step" href="#visit">
                <span class="welcome-step__num" aria-hidden="true">03</span>
                <span class="welcome-step__label">Desfrute</span>
                <span class="welcome-step__fact">{cafe.hours}</span>
                <span class="welcome-step__note">Planeie a sua visita.</span>
              </a>
            </li>
          </ol>
        </div>
      </div>

      <section class="section section--visit" id="visit" aria-labelledby="visit-title">
        <div class="shell section__inner">
          <div class="section-heading" data-reveal>
            <p class="section-heading__index">Visite-nos</p>
            <h2 id="visit-title">Planeie a sua visita</h2>
          </div>

          <dl class="info-list">
            <div class="info-row info-row--featured info-row--phone" data-reveal style="--i: 0">
              <dt>Telefone</dt>
              <dd class="info-row__phones">
                {cafe.contacts.map((contact) => {
                  const digits = contact.phone.replace(/\D/g, '');
                  return (
                    <a class="info-row__phone-link" href={`tel:${digits}`}>
                      <span class="info-row__phone-name">{contact.name}</span>
                      <span>{contact.phone}</span>
                    </a>
                  );
                })}
              </dd>
            </div>
            <div class="info-row info-row--address" data-reveal style="--i: 1">
              <dt>Morada</dt>
              <dd>{cafe.address}</dd>
            </div>
            <div class="info-row info-row--hours" data-reveal style="--i: 2">
              <dt>Horário</dt>
              <dd data-hours={cafe.hours}><span>{cafe.hours}</span></dd>
            </div>
            <div class="info-row info-row--directions" data-reveal style="--i: 3">
              <dt>Direções</dt>
              <dd>
                {mapHref ? <a href={mapHref} target="_blank" rel="noreferrer">Abrir no Google Maps</a> : <span class="placeholder">{cafe.map}</span>}
              </dd>
            </div>
          </dl>
        </div>
      </section>

      <section class="section section--gallery" id="gallery" aria-labelledby="gallery-title">
        <div class="shell section__inner">
          <div class="section-heading" data-reveal>
            <p class="section-heading__index">Fotografias</p>
            <h2 id="gallery-title">Veja o espaço</h2>
          </div>
          {cafe.gallery.length === 0 ? (
            <div class="gallery-empty" role="status" data-reveal>
              <div class="gallery-empty__mark" aria-hidden="true">✦</div>
              <div>
                <h3>Fotografias em breve</h3>
                <p>As fotografias do café serão adicionadas quando forem fornecidas.</p>
              </div>
            </div>
          ) : (
            <div class="gallery-grid">
              {cafe.gallery.map((image) => (
                <figure class="gallery-card">
                  <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
                  <figcaption>{image.caption}</figcaption>
                </figure>
              ))}
            </div>
          )}
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell site-footer__inner">
        <div class="site-footer__brand">
          <p class="site-footer__eyebrow">Café o Alexandre</p>
          <p class="site-footer__note">Morada e horário confirmados.</p>
        </div>
        <dl class="site-footer__facts">
          <div class="site-footer__fact">
            <dt>Morada</dt>
            <dd>{cafe.address}</dd>
          </div>
          <div class="site-footer__fact">
            <dt>Horário</dt>
            <dd>{cafe.hours}</dd>
          </div>
        </dl>
        {phoneFooterHref && <a class="footer-phone" href={phoneFooterHref}>{cafe.phoneFooter}</a>}
      </div>
    </footer>

    <CallMenu variant="callbar" />

    <script>
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const hoursRow = document.querySelector('[data-hours]');
      if (hoursRow) {
        const match = (hoursRow.dataset.hours || '').match(/(\d{1,2}):(\d{2})\s*[–-]\s*(\d{1,2}):(\d{2})/);
        if (match) {
          const now = new Date();
          const nowMins = now.getHours() * 60 + now.getMinutes();
          const openMins = parseInt(match[1], 10) * 60 + parseInt(match[2], 10);
          const closeMins = parseInt(match[3], 10) * 60 + parseInt(match[4], 10);
          const isOpen = nowMins >= openMins && nowMins < closeMins;
          const label = isOpen ? 'Aberto agora' : 'Fechado agora';
          const pill = document.createElement('span');
          pill.className = `hours-status ${isOpen ? 'hours-status--open' : 'hours-status--closed'}`;
          pill.setAttribute('aria-label', label);
          pill.innerHTML = `<span class="hours-status__dot" aria-hidden="true"></span>${label}`;
          hoursRow.appendChild(pill);
        }
      }

      if (!reducedMotion && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('motion-ready');
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.14, rootMargin: '0px 0px -8% 0px' }
        );

        document.querySelectorAll('[data-reveal]').forEach((element) => revealObserver.observe(element));

      }
    </script>

    <script type="module">
      const callMenus = Array.from(document.querySelectorAll('.call-menu'));
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const CLOSE_MS = reduceMotion ? 0 : 170;
      let openedAt = 0;

      function closeMenu(menu) {
        if (!menu.open || menu.classList.contains('call-menu--closing')) return;
        menu.classList.add('call-menu--closing');
        setTimeout(() => {
          menu.open = false;
          menu.classList.remove('call-menu--closing');
        }, CLOSE_MS);
      }

      function closeAllMenus() {
        callMenus.forEach(closeMenu);
      }

      callMenus.forEach((menu) => {
        const summary = menu.querySelector('summary');
        summary.addEventListener('click', (event) => {
          event.preventDefault();
          if (menu.open) {
            closeMenu(menu);
          } else {
            closeAllMenus();
            menu.open = true;
            openedAt = performance.now();
          }
        });
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeAllMenus();
      });

      document.addEventListener('click', (event) => {
        if (!event.target.closest('.call-menu')) closeAllMenus();
      });

      let scrolled = false;
      window.addEventListener('scroll', () => {
        if (scrolled) return;
        scrolled = true;
        requestAnimationFrame(() => {
          if (performance.now() - openedAt > 250) closeAllMenus();
          scrolled = false;
        });
      }, { passive: true });
    </script>
  </body>
</html>
